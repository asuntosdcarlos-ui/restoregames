rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isAdmin() { return signedIn() && exists(userDoc()) && get(userDoc()).data.role == 'admin'; }

    function validNode(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.content is string && d.content.size() <= 200000
        && d.files is list && d.files.size() <= 100
        && d.icon is string && d.icon.size() <= 16
        && d.openEdit is bool;
    }

    // Perfiles: cada uno edita el suyo; el rol "admin" solo se pone desde la consola.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', null) == resource.data.get('role', null);
      allow delete: if false;
    }

    // Páginas (categorías, juegos, mods… todo es un "node")
    match /nodes/{id} {
      allow read: if true;

      // Las categorías principales (parentId == null) solo las crea un admin.
      allow create: if signedIn()
        && validNode(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && (request.resource.data.parentId == null
              ? isAdmin()
              : exists(/databases/$(database)/documents/nodes/$(request.resource.data.parentId)));

      // Edita el autor, un admin, o cualquiera si la página tiene "edición abierta".
      // Nadie puede cambiar autor, padre ni ruta; solo autor/admin cambian openEdit.
      allow update: if signedIn()
        && validNode(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.ancestors == resource.data.ancestors
        && (resource.data.authorId == request.auth.uid || isAdmin()
            || (resource.data.openEdit == true && request.resource.data.openEdit == true));

      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
